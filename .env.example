PORT=4001
NODE_ENV=production
# Local dev: run `docker compose -f docker-compose.yml -f docker-compose.development.yml up -d mongo`
# Uses host port 27018 (27017 may already be in use by another Mongo instance)
MONGO_CONNECTION_STRING=mongodb://localhost:27018/revengine-dev
SUPPRESS_NO_CONFIG_WARNING=true
SHARED_SECRET=
API_SERVER=http://localhost:4001
APIKEY=
# API docs browser: protected (default) | disabled | public
# Protected = guides public; model explorer requires POST /login
DOCS_ACCESS=protected
# Optional: pre-fill email on docs sign-in form
# DOCS_USER_EMAIL=
# Login brute-force limit (default on): burst 8, 12/min per IP
# LOGIN_RATE_LIMIT_XFF=true
TOKEN_EXPIRY=86400
REFRESH_TOKEN_EXPIRY=2678400
FRONTEND_SITENAME=DM RevEngine
FRONTEND_URL=https://admin.revengine.example.com/
MAILER_FROM=Revengine <revengine@example.com>
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=465
SMTP_SENDMAIL=false
SMTP_USER=
SMTP_PASS=

# MCP (JXP 5+) — read-only AI tools at /mcp on the same port as the API
# MCP_ENABLED=true
