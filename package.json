{
	"name": "revengine-api",
	"version": "2.0.1",
	"description": "The RevEngine RESTful API",
	"main": "bin/server.js",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"start": "node bin/server.js",
		"dev": "nodemon bin/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run test/e2e",
		"link:jxp": "node scripts/jxp-link.js link",
		"unlink:jxp": "node scripts/jxp-link.js unlink",
		"postinstall": "node scripts/jxp-link.js postinstall"
	},
	"dependencies": {
		"dotenv": "^16.4.7",
		"jxp": "^2.15.1",
		"jxp-helper": "^1.4.3",
		"moment": "^2.30.1",
		"mongoose": "6.12.6",
		"mongoose-friendly": "^0.1.4",
		"nodemailer": "^6.10.0",
		"simple-statistics": "^7.8.3"
	},
	"devDependencies": {
		"nodemon": "^3.1.0",
		"vitest": "^4.1.6"
	},
