{
	"name": "revengine-api",
	"version": "4.7.0",
	"description": "The RevEngine RESTful API",
	"main": "dist/bin/server.js",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/bin/server.js",
		"dev": "nodemon",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run test/e2e",
		"link:jxp": "node scripts/jxp-link.js link",
		"unlink:jxp": "node scripts/jxp-link.js unlink",
		"postinstall": "node scripts/jxp-link.js postinstall",
		"docker:build": "./docker-build",
		"docker:push": "./docker-build",
		"docker:stable": "./docker-promote-stable"
	},
	"dependencies": {
		"dotenv": "^16.4.7",
		"jxp": "^5.0.3",
		"jxp-helper": "^1.4.3",
		"moment": "^2.30.1",
		"mongoose": "6.13.10",
		"mongoose-friendly": "^0.1.4",
		"nodemailer": "^9.0.3",
		"simple-statistics": "^7.8.9"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"@types/nodemailer": "^8.0.1",
		"nodemon": "^3.1.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.6"
	},
	"author": "Jason Norwood-Young <jason@10layer.com>",
	"license": "MIT",
	"overrides": {
		"@hono/node-server": "^2.0.5",
		"find-my-way": "^8.2.2",
		"send": "^0.19.0",
		"uuid": "^11.1.1"
	},
	"packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
